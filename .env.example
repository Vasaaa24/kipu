# Zkopírujte do .env.local a doplňte hodnoty. .env.local se necommituje.

# API klíč z https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Odesílatel. Pro testování: onboarding@resend.dev
# Po ověření domény kipu.cz v Resendu např.: KIPU web <web@kipu.cz>
RESEND_FROM="KIPU web <onboarding@resend.dev>"

# Volitelné: přepíše příjemce poptávek (čárkou oddělené).
# S onboarding@resend.dev lze posílat JEN na e-mail vašeho Resend účtu –
# pro testování sem dejte ten e-mail. Po ověření domény nechte prázdné
# (poptávky pak chodí na adresy ze src/config/site.ts → form.recipients).
CONTACT_TO_OVERRIDE=

# Produkční URL webu (metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.kipu.cz
